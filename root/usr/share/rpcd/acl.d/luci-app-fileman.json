{
  "luci-app-fileman": {
    "description": "Grant access to File Manager",
    "read": {
      "ubus": {
        "fileman": [ "list", "stat", "read", "download" ]
      }
    },
    "write": {
      "ubus": {
        "fileman": [ "mkdir", "rm", "mv", "copy", "touch", "write" ]
      }
    }
  }
}
